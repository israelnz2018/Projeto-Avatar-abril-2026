rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "israelnz2018@hotmail.com" ||
        request.auth.token.email == "israel@learningbyworking.com"
      );
    }

    // Global Admin Override: The owner can do ANYTHING
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
      );
    }

    function isCoordenador() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipoUsuario == 'coordenador';
    }

    function sameEmpresa(otherUserId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId != null &&
        get(/databases/$(database)/documents/users/$(otherUserId)).data.empresaId ==
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId;
    }

    function resourceMesmaEmpresa() {
      return isAuthenticated() &&
        minhaEmpresaId() != null &&
        resource.data.empresaId == minhaEmpresaId();
    }

    function novoMesmaEmpresa() {
      return isAuthenticated() &&
        minhaEmpresaId() != null &&
        request.resource.data.empresaId == minhaEmpresaId();
    }

    function userMesmoConsultorPorDados(d) {
      return isAuthenticated() &&
        (d.consultorId == meuConsultorId() ||
          (('consultorIds' in d) && d.consultorIds.hasAny([meuConsultorId()])));
    }

    function projectOwnerSameEmpresa(projectId) {
      return isAuthenticated() &&
        sameEmpresa(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid);
    }

    // ===== Multi-tenant (white-label) — NOVO =====
    // consultorId de quem pede, e se ele é consultor. Doc de outro user do mesmo consultor?
    function meuConsultorId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.consultorId;
    }
    function ehConsultor() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipoUsuario == 'consultor';
    }
    function mesmoConsultorUser(otherUserId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(otherUserId)).data.consultorId == meuConsultorId();
    }

    function pertenceAoMeuConsultor() {
      return resource.data.consultorId == meuConsultorId() ||
        (!('consultorId' in resource.data) && meuConsultorId() == 'israel');
    }

    function novoPertenceAoMeuConsultor() {
      return request.resource.data.consultorId == meuConsultorId() ||
        (!('consultorId' in request.resource.data) && meuConsultorId() == 'israel');
    }

    function minhaEmpresaId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId;
    }

    function podeAcessarComunidade(d) {
      return isAuthenticated() && (
        (d.escopo == 'rede' && (isAdmin() || ehConsultor())) ||
        (d.escopo == 'consultor' && d.consultorId == meuConsultorId()) ||
        // 'time': o dono do time (mesmo empresaId) sempre lê o próprio. O consultor
        // dono do tenant lê QUALQUER time dele (precisa pro seletor de comunidade por
        // coordenador/alunos diretos) — sem isso só o admin (bypass global) conseguia trocar de time.
        (d.escopo == 'time' && d.consultorId == meuConsultorId() && (d.empresaId == minhaEmpresaId() || ehConsultor())) ||
        (!('escopo' in d) && meuConsultorId() == 'israel')
      );
    }

    function ownerPodeAtualizarPerfil() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lastLogin',
        'primeiroAcessoEm',
        'senhaProvisoria',
        'nome',
        'fotoUrl',
        'empresaPerfil',
        'cargo',
        'siglaPpt',
        'creditoIA'
      ]) && creditoIAOwnerValido();
    }

    function creditoIAOwnerValido() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creditoIA']) || (
        request.resource.data.creditoIA.limite == resource.data.creditoIA.limite &&
        request.resource.data.creditoIA.keys().hasOnly([
          'limite',
          'usado',
          'resetEm',
          'solicitouMais',
          'solicitadoEm'
        ]) &&
        (
          // Consumo normal: só pode aumentar o usado.
          request.resource.data.creditoIA.usado >= resource.data.creditoIA.usado ||
          // Reset mensal controlado pelo app: só zera, mantendo o limite.
          request.resource.data.creditoIA.usado == 0
        )
      );
    }

    function apiUsageValido(docId) {
      return request.resource.data.keys().hasOnly([
        'date',
        'geminiCalls',
        'geminiPromptTokens',
        'geminiCandidatesTokens',
        'geminiTotalTokens',
        'geminiFailures',
        'anthropicCalls',
        'anthropicInputTokens',
        'anthropicOutputTokens',
        'anthropicTotalTokens',
        'anthropicFailures',
        'lastUpdatedAt'
      ]) &&
      request.resource.data.date == docId;
    }

    match /users/{userId} {
      // ehConsultor() && resource.data.consultorId == meuConsultorId() — comparação DIRETA
      // no próprio documento sendo lido, em vez de mesmoConsultorUser(userId) (que fazia um
      // get() redundante no MESMO doc, já que resource.data JÁ é os dados desse userId).
      // Esse get() auto-referente quebrava QUERIES em lista (ex.: Meus Coordenadores, Meus
      // Alunos filtrando users por consultorId) com "Missing or insufficient permissions" —
      // o Firestore não consegue provar a regra pra uma lista quando ela depende de um
      // get() por documento. Comparação direta de campo é 100% "list-safe".
      allow read:   if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isCoordenador() && resourceMesmaEmpresa()) ||
        (ehConsultor() && (
          resource.data.consultorId == meuConsultorId() ||
          (('consultorIds' in resource.data) && resource.data.consultorIds.hasAny([meuConsultorId()]))
        ))
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Consultor pode atualizar os usuários do mundo dele (ex.: liberar cursos por aluno).
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && ownerPodeAtualizarPerfil()) ||
        (ehConsultor() && !isOwner(userId) && userMesmoConsultorPorDados(resource.data) && userMesmoConsultorPorDados(request.resource.data)) ||
        (isCoordenador() && !isOwner(userId) && resourceMesmaEmpresa() && novoMesmaEmpresa())
      );
      allow delete: if isAdmin() ||
        (ehConsultor() && !isOwner(userId) && userMesmoConsultorPorDados(resource.data)) ||
        (isCoordenador() && !isOwner(userId) && resourceMesmaEmpresa());
    }

    match /invites/{inviteKey} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.email == request.auth.token.email) ||
        (ehConsultor() && resource.data.consultorId == meuConsultorId()) ||
        (isCoordenador() && resource.data.empresaId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId);
      allow create: if isAdmin() ||
        (ehConsultor() && request.resource.data.consultorId == meuConsultorId()) ||
        (isCoordenador() && request.resource.data.empresaId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId);
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.email == request.auth.token.email) ||
        (ehConsultor() && resource.data.consultorId == meuConsultorId()) ||
        (isCoordenador() && resource.data.empresaId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId);
    }

    // Consultores (tenants white-label) — marca/vitrine é PÚBLICA (sem dado sensível).
    // Escreve: admin (super-admin) OU o próprio consultor editando a marca/vitrine dele.
    match /consultores/{consultorId} {
      allow read: if true;
      allow write: if isAdmin() || (ehConsultor() && consultorId == meuConsultorId());
    }

    // Chaves das Video Libraries do Bunny por consultor — SÓ o servidor (admin SDK) lê/escreve.
    // Guarda a AccessKey da library (SECRETA) — o cliente/consultor NUNCA acessa.
    match /bunny_libraries/{consultorId} {
      allow read, write: if isAdmin();
    }

    // Repasse B2B (repasses/{empresaId}): valor da NF + parcelas + trava do certificado.
    // Leitura: autenticado (o aluno precisa checar a trava do certificado da empresa dele).
    // Escrita: admin OU consultor (o dono do mundo registra/quita o repasse).
    match /repasses/{empresaId} {
      allow read:  if isAuthenticated() && (
        isAdmin() ||
        resource.data.consultorId == meuConsultorId() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId == empresaId
      );
      allow write: if isAdmin() || (ehConsultor() && request.resource.data.consultorId == meuConsultorId());
    }

    // Provas de certificação — escopadas por consultor (doc id = `{consultorId}__{trilha}`).
    // Leitura direta (client SDK): só admin OU o consultor DONO daquela prova (o aluno
    // carrega a prova pelo servidor, via /api/quizzes/list, sem gabarito — não lê este doc).
    // Escrita: admin OU consultor (cada consultor edita a prova do mundo dele).
    match /quizzes/{quizId} {
      allow read:  if isAdmin() || (ehConsultor() && pertenceAoMeuConsultor());
      allow create: if isAdmin() || (ehConsultor() && novoPertenceAoMeuConsultor());
      allow update, delete: if isAdmin() || (ehConsultor() && pertenceAoMeuConsultor() && novoPertenceAoMeuConsultor());
    }

    match /quiz_attempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Marca do TIME (PPT) — o coordenador escolhe usar o PPT do consultor ou o dele
    // (sigla + 3 cores). Guarda SÓ sigla + cores (sem dado sensível), então a leitura
    // é aberta a autenticados: o coordenador E os alunos do time leem o MESMO doc pra
    // vestir os PPTs. Escreve: admin OU o coordenador dono daquela empresa (empresaId).
    function teamBrandingValido(empresaId) {
      return request.resource.data.keys().hasOnly([
        'empresaId',
        'consultorId',
        'nomeEmpresa',
        'logoUrl',
        'siglaPpt',
        'coresPpt',
        'pptFonte',
        'pptCapaUrl',
        'pptInternaUrl',
        'atualizadoEm'
      ]) &&
      request.resource.data.empresaId == empresaId &&
      request.resource.data.consultorId == meuConsultorId() &&
      (!('nomeEmpresa' in request.resource.data) || request.resource.data.nomeEmpresa is string) &&
      (!('logoUrl' in request.resource.data) || request.resource.data.logoUrl == null || request.resource.data.logoUrl is string) &&
      (!('siglaPpt' in request.resource.data) || request.resource.data.siglaPpt is string) &&
      (!('coresPpt' in request.resource.data) || request.resource.data.coresPpt is map) &&
      request.resource.data.pptFonte in ['consultor', 'proprio'] &&
      (
        request.resource.data.pptFonte == 'consultor' ||
        (
          request.resource.data.pptCapaUrl is string &&
          request.resource.data.pptInternaUrl is string
        )
      );
    }

    match /team_branding/{empresaId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin() || (
        isCoordenador() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId == empresaId &&
        teamBrandingValido(empresaId)
      );
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        (isCoordenador() && sameEmpresa(resource.data.ownerUid)) ||
        (ehConsultor() && resource.data.consultorId == meuConsultorId())
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.ownerUid == request.auth.uid ||
        (isCoordenador() && sameEmpresa(request.resource.data.ownerUid)) ||
        (ehConsultor() && request.resource.data.consultorId == meuConsultorId())
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (isCoordenador() && sameEmpresa(resource.data.ownerUid) && sameEmpresa(request.resource.data.ownerUid)) ||
        (ehConsultor() && resource.data.consultorId == meuConsultorId() && request.resource.data.consultorId == meuConsultorId())
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (isCoordenador() && sameEmpresa(resource.data.ownerUid)) ||
        (ehConsultor() && resource.data.consultorId == meuConsultorId())
      );

      match /data/{dataId} {
        allow read: if isProjectOwner(projectId) || isAdmin() ||
                       (isCoordenador() && projectOwnerSameEmpresa(projectId)) ||
                       (ehConsultor() && get(/databases/$(database)/documents/projects/$(projectId)).data.consultorId == meuConsultorId());
        allow write: if isProjectOwner(projectId) || isAdmin() ||
                       (isCoordenador() && projectOwnerSameEmpresa(projectId)) ||
                       (ehConsultor() && get(/databases/$(database)/documents/projects/$(projectId)).data.consultorId == meuConsultorId());
      }
    }

    match /initiatives/{initiativeId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.consultorId == meuConsultorId() ||
        (!('consultorId' in resource.data) && meuConsultorId() == 'israel')
      );
      allow create: if isAdmin() || (ehConsultor() && novoPertenceAoMeuConsultor());
      allow update, delete: if isAdmin() || (ehConsultor() && pertenceAoMeuConsultor() && novoPertenceAoMeuConsultor());
    }

    match /initiative_configs/{configId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.consultorId == meuConsultorId() ||
        (!('consultorId' in resource.data) && meuConsultorId() == 'israel')
      );
      allow create: if isAdmin() || (ehConsultor() && novoPertenceAoMeuConsultor());
      allow update, delete: if isAdmin() || (ehConsultor() && pertenceAoMeuConsultor() && novoPertenceAoMeuConsultor());
    }

    match /config/{docId} {
      // Config genérica por tenant (ex.: itens do depoimento pré-prova). Doc legado
      // 'opiniaoItens' sem consultorId pertence ao Israel (mesma regra de initiatives/courses).
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.consultorId == meuConsultorId() ||
        (!('consultorId' in resource.data) && meuConsultorId() == 'israel')
      );
      allow create: if isAdmin() || (ehConsultor() && novoPertenceAoMeuConsultor());
      allow update, delete: if isAdmin() || (ehConsultor() && pertenceAoMeuConsultor() && novoPertenceAoMeuConsultor());
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.consultorId == meuConsultorId() ||
        (!('consultorId' in resource.data) && meuConsultorId() == 'israel')
      );
      allow create: if isAdmin() || (ehConsultor() && novoPertenceAoMeuConsultor());
      allow update, delete: if isAdmin() || (ehConsultor() && pertenceAoMeuConsultor() && novoPertenceAoMeuConsultor());
    }

    match /playlists/{playlistId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.consultorId == meuConsultorId() ||
        (!('consultorId' in resource.data) && meuConsultorId() == 'israel')
      );
      allow create: if isAdmin() || (ehConsultor() && novoPertenceAoMeuConsultor());
      allow update, delete: if isAdmin() || (ehConsultor() && pertenceAoMeuConsultor() && novoPertenceAoMeuConsultor());
    }

    match /knowledge_base/{itemId} {
      // Leitura isolada por tenant. Itens legados sem consultorId pertencem ao Israel.
      // Exceção: institucional==true são os vídeos fixos de "como usar a plataforma"
      // (aba Data Analysis) — visíveis para qualquer consultor, não só o dono do conteúdo.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.consultorId == meuConsultorId() ||
        (!('consultorId' in resource.data) && meuConsultorId() == 'israel') ||
        resource.data.institucional == true
      );
      // Escrita isolada por tenant: admin, OU consultor no conteúdo do PRÓPRIO consultorId.
      // (Antes era `if isAuthenticated()` — qualquer um escrevia; só o admin usava.)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (ehConsultor() && request.resource.data.consultorId == meuConsultorId())
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        (ehConsultor() && resource.data.consultorId == meuConsultorId())
      );
    }

    match /support_materials/{materialId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.consultorId == meuConsultorId()
      );
      allow create: if isAdmin() || (
        ehConsultor() && request.resource.data.consultorId == meuConsultorId()
      );
      allow update: if isAdmin() || (
        ehConsultor() &&
        resource.data.consultorId == meuConsultorId() &&
        request.resource.data.consultorId == meuConsultorId()
      );
      allow delete: if isAdmin() || (
        ehConsultor() && resource.data.consultorId == meuConsultorId()
      );
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /mentor_conversations/{conversationId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /pending_questions/{questionId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /mentor_tool_context/{toolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /app_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /api_usage/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated() && apiUsageValido(docId);
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read:   if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ===== Comunidade LBW =====
    match /community/{postId} {
      allow read:   if isAdmin() || podeAcessarComunidade(resource.data);
      allow create: if isAuthenticated() &&
        request.resource.data.autor.uid == request.auth.uid &&
        podeAcessarComunidade(request.resource.data);
      allow update: if isAuthenticated() &&
        (isAdmin() || resource.data.autor.uid == request.auth.uid) &&
        podeAcessarComunidade(resource.data) &&
        podeAcessarComunidade(request.resource.data);
      allow delete: if isAuthenticated() &&
        (isAdmin() || resource.data.autor.uid == request.auth.uid) &&
        podeAcessarComunidade(resource.data);

      match /replies/{replyId} {
        allow read: if isAdmin() ||
          podeAcessarComunidade(get(/databases/$(database)/documents/community/$(postId)).data);
        allow create: if isAuthenticated() &&
          request.resource.data.autor.uid == request.auth.uid &&
          podeAcessarComunidade(get(/databases/$(database)/documents/community/$(postId)).data);
        allow update, delete: if isAuthenticated() &&
          (isAdmin() || resource.data.autor.uid == request.auth.uid) &&
          podeAcessarComunidade(get(/databases/$(database)/documents/community/$(postId)).data);
      }
    }

    match /community_notifications/{notifId} {
      allow read:   if isAuthenticated() && (isAdmin() || resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['toUid', 'postId', 'fromNome', 'trecho', 'lida', 'createdAt']) &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.lida == false &&
        podeAcessarComunidade(get(/databases/$(database)/documents/community/$(request.resource.data.postId)).data);
      allow update: if isAuthenticated() &&
        (isAdmin() || resource.data.toUid == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.toUid == request.auth.uid);
    }
    // ===== Fim Comunidade LBW =====

    match /eventos/{eventoId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Progresso de vídeos assistidos — 1 doc por aluno (id = uid).
    // certificadosEmitidos só é gravado pelo servidor (/api/certificados/emitir, Admin SDK,
    // já coberto pelo override global de admin no topo do arquivo) — o dono pode gravar
    // watchedUrls/lastUpdated livremente, mas NÃO pode criar/alterar certificado direto.
    match /userProgress/{userId} {
      allow read:   if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isCoordenador() && sameEmpresa(userId)) ||
        (ehConsultor() && mesmoConsultorUser(userId))
      );
      allow create: if isAuthenticated() && (isAdmin() ||
        (isCoordenador() && sameEmpresa(userId)) ||
        (ehConsultor() && mesmoConsultorUser(userId)) || (
        isOwner(userId) &&
        (!('certificadosEmitidos' in request.resource.data) || request.resource.data.certificadosEmitidos.size() == 0)
      ));
      allow update: if isAuthenticated() && (isAdmin() ||
        (isCoordenador() && sameEmpresa(userId)) ||
        (ehConsultor() && mesmoConsultorUser(userId)) || (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['certificadosEmitidos']) ||
          request.resource.data.certificadosEmitidos == resource.data.certificadosEmitidos
        )
      ));
      allow delete: if isAdmin() ||
        (isCoordenador() && sameEmpresa(userId)) ||
        (ehConsultor() && mesmoConsultorUser(userId));
    }

    // Snapshot público de certificados — leitura ABERTA (qualquer pessoa com o certId valida).
    match /certificadosPublicos/{certId} {
      allow read:  if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
