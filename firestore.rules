rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "israelnz2018@hotmail.com" ||
        request.auth.token.email == "israel@learningbyworking.com"
      );
    }

    // Global Admin Override: The owner can do ANYTHING
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
      );
    }

    function isCoordenador() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipoUsuario == 'coordenador';
    }

    function sameEmpresa(otherUserId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId != null &&
        get(/databases/$(database)/documents/users/$(otherUserId)).data.empresaId ==
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId;
    }

    function projectOwnerSameEmpresa(projectId) {
      return isAuthenticated() &&
        sameEmpresa(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid);
    }

    // ===== Multi-tenant (white-label) — NOVO =====
    // consultorId de quem pede, e se ele é consultor. Doc de outro user do mesmo consultor?
    function meuConsultorId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.consultorId;
    }
    function ehConsultor() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipoUsuario == 'consultor';
    }
    function mesmoConsultorUser(otherUserId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(otherUserId)).data.consultorId == meuConsultorId();
    }

    match /users/{userId} {
      allow read:   if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isCoordenador() && sameEmpresa(userId)) ||
        (ehConsultor() && mesmoConsultorUser(userId))
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow delete: if isAdmin();
    }

    match /invites/{inviteKey} {
      allow read:   if isAuthenticated();
      allow write:  if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
    }

    // Consultores (tenants white-label) — marca/vitrine é PÚBLICA (sem dado sensível).
    // Escreve: admin (super-admin) OU o próprio consultor editando a marca/vitrine dele.
    match /consultores/{consultorId} {
      allow read: if true;
      allow write: if isAdmin() || (ehConsultor() && consultorId == meuConsultorId());
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        (isCoordenador() && sameEmpresa(resource.data.ownerUid)) ||
        (ehConsultor() && resource.data.consultorId == meuConsultorId())
      );
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.ownerUid == request.auth.uid);

      match /data/{dataId} {
        allow read: if isProjectOwner(projectId) || isAdmin() ||
                       (isCoordenador() && projectOwnerSameEmpresa(projectId)) ||
                       (ehConsultor() && get(/databases/$(database)/documents/projects/$(projectId)).data.consultorId == meuConsultorId());
        allow write: if isProjectOwner(projectId) || isAdmin();
      }
    }

    match /initiatives/{initiativeId} {
      allow read, write: if true;
    }

    match /initiative_configs/{configId} {
      allow read, write: if true;
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /playlists/{playlistId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /knowledge_base/{itemId} {
      // Leitura segue autenticada (o app já filtra o conteúdo por consultorId na query).
      allow read: if isAuthenticated();
      // Escrita isolada por tenant: admin, OU consultor no conteúdo do PRÓPRIO consultorId.
      // (Antes era `if isAuthenticated()` — qualquer um escrevia; só o admin usava.)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (ehConsultor() && request.resource.data.consultorId == meuConsultorId())
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        (ehConsultor() && resource.data.consultorId == meuConsultorId())
      );
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /mentor_conversations/{conversationId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /pending_questions/{questionId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /mentor_tool_context/{toolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /app_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /api_usage/{docId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    match /feedback/{feedbackId} {
      allow read:   if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ===== Comunidade LBW =====
    match /community/{postId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.autor.uid == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.autor.uid == request.auth.uid);

      match /replies/{replyId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.autor.uid == request.auth.uid;
        allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.autor.uid == request.auth.uid);
      }
    }

    match /community_notifications/{notifId} {
      allow read:   if isAuthenticated() && (isAdmin() || resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.toUid == request.auth.uid);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.toUid == request.auth.uid);
    }
    // ===== Fim Comunidade LBW =====

    match /eventos/{eventoId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Progresso de vídeos assistidos — 1 doc por aluno (id = uid).
    match /userProgress/{userId} {
      allow read:   if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        (isCoordenador() && sameEmpresa(userId)) ||
        (ehConsultor() && mesmoConsultorUser(userId))
      );
      allow create, update: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow delete: if isAdmin();
    }

    // Snapshot público de certificados — leitura ABERTA (qualquer pessoa com o certId valida).
    match /certificadosPublicos/{certId} {
      allow read:  if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
