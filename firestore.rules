rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - ownerUid: string (required)
    //   - ownerEmail: string (optional)
    //   - currentPhase: string (required)
    //   - createdAt: timestamp (required)
    //   - completedTools: list (optional)
    //
    // Collection: projects/{projectId}/data
    // Document ID: toolType
    // Fields:
    //   - toolType: string (required)
    //   - content: map (required)
    //   - updatedAt: timestamp (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "israelnz2018@hotmail.com" || 
        request.auth.token.email == "israel@learningbyworking.com"
      );
    }

    // Global Admin Override: The owner can do ANYTHING
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
      );
    }

    // Users — cada aluno pode ler/criar/atualizar APENAS o seu próprio doc.
    // Quando ele migra de plano (gratuito → completo) o uid é o mesmo,
    // então projects/knowledge_base/mentor_conversations dele continuam acessíveis
    // automaticamente porque dependem de ownerUid/userId, não do plano.
    match /users/{userId} {
      allow read:   if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow delete: if isAdmin();
    }

    // Invites — gerenciados pelo admin (ou n8n via service account no futuro).
    // Aluno autenticado lê pra que ensureUserDocument puxe nome/formações
    // do convite, e pode deletar quando consumir no primeiro login.
    match /invites/{inviteKey} {
      allow read:   if isAuthenticated();
      allow write:  if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
    }

    // Projects
    match /projects/{projectId} {
      // Allow read if user is owner or admin
      allow read: if isAuthenticated() && (isAdmin() || resource == null || resource.data.ownerUid == request.auth.uid);
      
      // Allow create if authenticated and setting self as owner
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      
      // Allow update/delete if owner or admin
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      
      // Subcollection: data
      match /data/{dataId} {
        allow read, write: if isProjectOwner(projectId) || isAdmin();
      }
    }

    // Initiatives and Configs
    match /initiatives/{initiativeId} {
      allow read, write: if true;
    }

    match /initiative_configs/{configId} {
      allow read, write: if true;
    }

    // Other collections (Publicly readable by authenticated users for now)
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /playlists/{playlistId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /knowledge_base/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Test collection for connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Mentor Conversations
    match /mentor_conversations/{conversationId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Pending Questions
    match /pending_questions/{questionId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Mentor Tool Context
    match /mentor_tool_context/{toolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // API settings (Gemini key, Anthropic key, modelo) — só admin.
    // Outros usuários precisam ler pra obter o modelo padrão usado nas chamadas
    // client-side; mas a key é mascarada na UI. Mantendo read auth-only.
    match /app_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Tracking de consumo de tokens — qualquer user autenticado incrementa
    // (write via SDK client após cada chamada Gemini); leitura só admin.
    match /api_usage/{docId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    // Feedback do aluno (bug / sugestão / dúvida) — aluno cria, admin lê.
    // Aluno só pode ver/escrever os próprios feedbacks (caso queira histórico).
    match /feedback/{feedbackId} {
      allow read:   if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
