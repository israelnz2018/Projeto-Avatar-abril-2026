# .env.example
# Este arquivo documenta as variáveis de ambiente necessárias para o projeto.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VITE_ANTHROPIC_API_KEY=
APP_URL=

# Backend de análises (Python — serviço Railway separado, repo israelnz2018/Analises)
# Usado pela aba Data & Analysis para rodar Pareto, Histograma, Gage R&R, etc.
# SERVER-SIDE: o front chama sempre /api/analises (proxy no server.ts) e o servidor
# repassa pra cá. Não use VITE_ANALISES_API_URL — chamar o serviço direto do navegador
# quebra com "Failed to fetch" nos subdomínios de consultor (a whitelist de CORS de lá
# só conhece app.educacaopelotrabalho.com). Deixe vazio pra usar o padrão de produção.
ANALISES_API_URL=

# n8n (automação — serviço Railway separado, repo israelnz2018/n8n)
# Usado pelo Login.tsx (esqueci minha senha) e pelos webhooks Hotmart
VITE_N8N_BASE_URL=https://primary-production-1d53.up.railway.app

# SMTP (Hostinger) — para envio automático de convites
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=israel@learningbyworking.com
SMTP_PASS=
SMTP_FROM=israel@learningbyworking.com

# Webhooks n8n usados como botão de ação dentro dos e-mails
N8N_WEBHOOK_GRATUITO=
N8N_WEBHOOK_PAGO=
N8N_WEBHOOK_COORDENADOR=

# Segredo compartilhado entre o n8n e o endpoint POST /api/acesso/liberar.
# O n8n manda no header x-lbw-secret; o servidor só aceita se bater.
# Use uma string longa e aleatória (ex: gere com um gerador de senha).
LBW_WEBHOOK_SECRET=

# Firebase Admin SDK (gestão de usuários pelo painel /users)
# Use UMA das duas opções:
#   - JSON inteiro inline (recomendado pra deploy)
#   - Caminho relativo pra um arquivo .json
# Como obter: Firebase Console → Configurações do projeto → Contas de serviço →
# "Gerar nova chave privada" → baixa o .json.
FIREBASE_ADMIN_KEY_JSON=
FIREBASE_ADMIN_KEY_PATH=

# ===== Bunny Stream (hospedagem de vídeo — migração YouTube→Bunny) =====
# SECRETO — só servidor (server.ts + script de migração). NUNCA expor no cliente.
# Onde achar: Bunny.net → Stream → sua Video Library → API → "API Key" (AccessKey).
BUNNY_STREAM_API_KEY=
# ID numérico da Video Library (não é secreto, mas fica aqui por organização).
BUNNY_LIBRARY_ID=
# Hostname do Pull Zone/CDN pra tocar o vídeo (público). Ex.: vz-xxxx.b-cdn.net
BUNNY_CDN_HOSTNAME=

# Chave de CONTA do Bunny (nivel bunny.net) — cria a Video Library de cada consultor
# no onboarding. SECRETA, so servidor. Bunny.net -> Account Settings -> API -> API Key.
BUNNY_ACCOUNT_API_KEY=
